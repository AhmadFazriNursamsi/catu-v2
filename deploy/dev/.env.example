# Salin ke .env di server (folder ~/Documents/catu-v2-dev) lalu isi. Jangan di-commit.
DB_HOST=shared-postgres
DB_PORT=5432
DB_NAME=catu_dev
DB_USERNAME=catu_dev
DB_PASSWORD=
# BEDA dari produksi (mis. hasil: openssl rand -hex 32)
JWT_SECRET=
# Data master (keuskupan..lingkungan) diisi otomatis saat pertama start; matikan dengan false bila sudah diisi manual.
MASTER_DATA_AUTO_SEED=true
DB_AUTO_MIGRATE=true
ENABLE_SWAGGER=true
# Alamat publik lewat gerbang (https://catu.devoutsys.com/dev/ dan /dev/api/)
DEV_PUBLIC_ORIGIN=https://catu.devoutsys.com
DEV_PUBLIC_HOST=catu.devoutsys.com
# Alamat server di jaringan lokal/VPN (akses langsung ke port, tanpa gerbang)
DEV_HOST=10.10.3.41
DEV_ADMIN_WEB_PORT=3013
DEV_BACKEND_PORT=4003
# Isi 127.0.0.1 bila dev hanya boleh dibuka dari server itu sendiri (mis. lewat terowongan SSH)
DEV_BIND=0.0.0.0
