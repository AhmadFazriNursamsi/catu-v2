# Salin ke .env di server (folder ~/Documents/catu-v2-dev) lalu isi. Jangan di-commit.
DB_HOST=shared-postgres
DB_PORT=5432
DB_NAME=catu_dev
DB_USERNAME=catu_dev
DB_PASSWORD=
# BEDA dari produksi (mis. hasil: openssl rand -hex 32)
JWT_SECRET=
# Data master (keuskupan..lingkungan) diisi otomatis saat pertama start; matikan dengan false bila sudah diisi manual.
MASTER_DATA_AUTO_SEED=true
DB_AUTO_MIGRATE=true
ENABLE_SWAGGER=true
