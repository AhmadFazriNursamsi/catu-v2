{
  "name": "catu-admin-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.src.css -o css/tailwind.css --minify",
    "predev": "npm run build:css",
    "dev": "vite --host 0.0.0.0 --port 8000",
    "start": "vite --mode production --host 0.0.0.0 --port 80",
    "test:xss": "node test/xss-render.check.cjs"
  },
  "dependencies": {
    "tailwindcss": "3.4.19",
    "vite": "6.4.6"
  }
}
