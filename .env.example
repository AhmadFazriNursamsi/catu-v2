# ==============================================================================
# CATU v2 - ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi .env dan sesuaikan dengan kredensial infrastruktur Anda.
# PENTING: JANGAN PERNAH men-commit file .env asli yang berisi rahasia produksi!
# ==============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
BACKEND_PORT=8001
ADMIN_WEB_PORT=8000
ADMIN_WEB_ALLOWED_HOSTS=your_admin_domain.com,localhost

# Database PostgreSQL
DB_HOST=shared-postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=catu

# Security - Cryptographic HS256 JWT secret key
JWT_SECRET=your_base64_or_hex_random_jwt_secret_minimum_32_chars

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# SearXNG
SEARXNG_BASE_URL=http://localhost:8888/
SEARXNG_INTERNAL_URL=http://shared-searxng:8080
SEARXNG_SECRET_KEY=your_random_searxng_secret_key_hex

# Public API URL disuntikkan ke Admin Web dan Mobile build.
# Gunakan domain HTTPS publik server API Anda.
PUBLIC_API_URL=https://api.yourdomain.com

# Public APK URL untuk tombol download dan QR code di Admin Web.
PUBLIC_APK_URL=https://api.yourdomain.com/public/apk

# Sensio Env Configuration (Cloud Storage / S3)
SENSIO_ENV_CONFIG_URL=http://sensio-env:3002
SENSIO_ENV_CONFIG_TOKEN_FILE=/run/secrets/sensio_env_config_token
SENSIO_ENV_CONFIG_WORKSPACE_ID=your_workspace_id
SENSIO_ENV_CONFIG_PROJECT_ID=your_project_id
SENSIO_ENV_CONFIG_CACHE_TTL_SECONDS=60
APK_S3_OBJECT_KEY=path/to/apk/CATU.apk
APK_DOWNLOAD_URL_TTL_SECONDS=300

# Mobile Client & iOS Build Configuration (Plug-and-Play)
CATU_API_URL=https://api.yourdomain.com
IOS_BUNDLE_ID=com.yourorganization.catuMobile
IOS_DEVELOPMENT_TEAM=YOUR_APPLE_TEAM_ID
# IOS_DEVICE_ID= (opsional: terdeteksi otomatis jika iPhone fisik terhubung)
