# ==============================================================================
# CATU v2 - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and set the shared infrastructure credentials.
# ==============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
BACKEND_PORT=8001
ADMIN_WEB_PORT=8000
ADMIN_WEB_ALLOWED_HOSTS=catu.farismunir.my.id
# Database PostgreSQL
DB_HOST=shared-postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_shared_postgres_password_here
DB_NAME=catu

# Security - Cryptographic HS256 JWT secret key
JWT_SECRET=your_base64_or_hex_random_jwt_secret_minimum_32_chars

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# SearXNG
SEARXNG_BASE_URL=http://localhost:8888/
SEARXNG_INTERNAL_URL=http://shared-searxng:8080

# Public API URL injected into Admin Web at container startup and into mobile builds.
# Set this per environment; production should use the HTTPS API domain.
PUBLIC_API_URL=https://api-catu.farismunir.my.id

# Public APK URL used by the Admin Web QR code and download button.
PUBLIC_APK_URL=https://api-catu.farismunir.my.id/public/apk

# Sensio Env supplies the shared AWS S3 credentials at runtime; do not copy AWS secrets here.
SENSIO_ENV_CONFIG_URL=http://sensio-env:3002
SENSIO_ENV_CONFIG_TOKEN_FILE=/run/secrets/sensio_env_config_token
SENSIO_ENV_CONFIG_WORKSPACE_ID=sensio
SENSIO_ENV_CONFIG_PROJECT_ID=sensio-notes
SENSIO_ENV_CONFIG_CACHE_TTL_SECONDS=60
APK_S3_OBJECT_KEY=Sensio/apk/CATU.apk
APK_DOWNLOAD_URL_TTL_SECONDS=300

# Mobile Client & iOS Build Configuration (Plug-and-Play)
CATU_API_URL=https://api-catu.farismunir.my.id
IOS_BUNDLE_ID=com.example.catuMobile
IOS_DEVELOPMENT_TEAM=MBN54724KP
# IOS_DEVICE_ID= (optional: auto-detected if physical iPhone is connected)
