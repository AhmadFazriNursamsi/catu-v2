# ==============================================================================
# CATU v2 - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and replace placeholder values with your secure secrets.
# ==============================================================================

NODE_ENV=production
PORT=3000
BACKEND_PORT=3005
ADMIN_WEB_PORT=8000
DB_EXTERNAL_PORT=5432

# Database PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=catu_v2_db

# Security - Cryptographic HS256 JWT secret key
JWT_SECRET=your_base64_or_hex_random_jwt_secret_minimum_32_chars

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# SearXNG
SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://localhost:8080/
SEARXNG_INTERNAL_URL=http://catu_searxng:8080
SEARXNG_SECRET_KEY=your_random_searxng_secret_key_hex

# Public URLs
PUBLIC_API_URL=http://10.0.10.92:3005
